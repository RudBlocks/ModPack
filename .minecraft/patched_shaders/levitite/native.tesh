#version 410 core
#extension GL_ARB_tessellation_shader : require
#define SHADER_FEATURE_COMPUTE 1
#define TESSELLATION_SHADER 1
#define SHADER_FEATURE_TESSELLATION 1
#define SHADER_FEATURE_VERTEX_ATTRIBUTE64 1
#define SHADER_FEATURE_BINDLESS_TEXTURE 1
#define SHADER_FEATURE_CUBE_MAP_ARRAY 1
#define SHADER_FEATURE_FLOAT64 1
#define SHADER_FEATURE_SHADER_STORAGE 1
#define SHADER_FEATURE_INT64 1
#define SHADER_FEATURE_ATOMIC_COUNTER 1
uniform vec3 offset;
uniform vec3 linearVelocity;
uniform vec3 angularVelocity;
uniform vec3 sublevelPosition;
uniform mat3 currentOrientation;
uniform float materialTransitionSpeed;
uniform mat3 materialMatrixSlow;
uniform mat3 materialMatrixFast;
vec3 getLocalPosition(vec3 relativePos) {
	return (relativePos - offset);
}
vec3 getVelocity(vec3 pos) {
	return (linearVelocity - cross(pos, angularVelocity));
}
vec3 getGlobalPosition(vec3 localPos) {
	return ((currentOrientation * localPos) + sublevelPosition);
}
vec3 getDragState(vec3 vel) {
	float x2 = (dot(vel, vel) / (materialTransitionSpeed * materialTransitionSpeed));
	float Q = exp((-1.5 * x2));
	float Q2 = -0.44626033;
	float h0 = dot(vel, (materialMatrixFast * vel));
	float h1 = dot(vel, (materialMatrixSlow * vel));
	float h10 = (h1 - h0);
	float peak = ((Q2 * h10) + h0);
	float D = peak > 0 ? (((((1 - (3 * x2)) * Q) * h10) + h0) / peak) : 0;
	D = max(D, 0);
	return vec3(Q, (1 - Q), D);
}
layout(quads) in ;
uniform sampler2D Noise;
in vec2 texCoord0_out[];
in vec4 vertexColor_out[];
in float vertexDistance_out[];
out vec2 texCoord0;
out vec4 vertexColor;
out float vertexDistance;
out float ghostLayerFullness;
out float ghostNoiseMagnitude;
out float depth;
uniform mat4 ProjMat;
uniform mat4 ModelViewMat;
uniform float time;
uniform int onSublevel;
uniform int layerIndex;
uniform float gravityStrength;
vec3 getNoiseFromPositionAndTime(vec4 p, vec3 noiseScale) {
	mat2 R1 = (mat2(25, 3, 2, 15) / 10);
	mat2 R2 = (mat2(15, 1, 2, -25) / 10);
	mat3 M1 = (mat3(10, 2, -1, 4, 10, -5, -3, -2, 10) / 10);
	mat3 M2 = transpose(M1);
	vec4 p1 = vec4((M1 * p.xyz), p.w);
	vec4 p2 = vec4((M2 * p.xyz), p.w);
	vec3 noiseOutX = (texture(Noise, (R1 * p1.zw)).xyz - texture(Noise, (R2 * p2.yw)).xyz);
	vec3 noiseOutY = (texture(Noise, (R1 * p1.xw)).xyz - texture(Noise, (R2 * p2.zw)).xyz);
	vec3 noiseOutZ = (texture(Noise, (R1 * p1.yw)).xyz - texture(Noise, (R2 * p2.xw)).xyz);
	mat3 mat = mat3(noiseOutX, noiseOutY, noiseOutZ);
	return (transpose(mat) * noiseScale);
}
void main(void) {
	vec4 tePosition = mix(mix(gl_in[0].gl_Position, gl_in[3].gl_Position, gl_TessCoord.y), mix(gl_in[1].gl_Position, gl_in[2].gl_Position, gl_TessCoord.y), gl_TessCoord.x);
	texCoord0 = mix(mix(texCoord0_out[0], texCoord0_out[3], gl_TessCoord.y), mix(texCoord0_out[1], texCoord0_out[2], gl_TessCoord.y), gl_TessCoord.x);
	vertexColor = mix(mix(vertexColor_out[0], vertexColor_out[3], gl_TessCoord.y), mix(vertexColor_out[1], vertexColor_out[2], gl_TessCoord.y), gl_TessCoord.x);
	vertexDistance = mix(mix(vertexDistance_out[0], vertexDistance_out[3], gl_TessCoord.y), mix(vertexDistance_out[1], vertexDistance_out[2], gl_TessCoord.y), gl_TessCoord.x);
	vec3 pos = tePosition.xyz;
	vec3 localPos = getLocalPosition(pos);
	vec3 vel = getVelocity(localPos);
	float l = onSublevel > 0 ? length(vel) : 0;
	float falloff = exp((-l / materialTransitionSpeed));
	float gravityScale = (1 - exp((-gravityStrength / 3.0)));
	ghostLayerFullness = ((1 - (falloff * falloff)) * gravityScale);
	if(layerIndex != 0) {
		vec3 p = localPos;
		float t = (time / 200);
		p /= 50;
		vec3 drag = getDragState(vel);
		vec3 modifier = (drag.yxz * vec3(0.4, 0.3, 0.2));
		vec3 nudge = getNoiseFromPositionAndTime(vec4(p, t), modifier);
		if(l > 1.0E-4) {
			nudge = mix(((vel * dot(nudge, vel)) / dot(vel, vel)), nudge, mix(1.0, 0.1, ((1 - falloff) * (1 - falloff))));
		}
		nudge *= ghostLayerFullness;
		pos += nudge;
	} else {
		vec3 drag = onSublevel > 0 ? getDragState(vel) : vec3(1, 0, 0);
		float t = (time / 500);
		vec3 localNoise = getNoiseFromPositionAndTime(vec4((localPos / 10), t), (vec3(1, 0, 0) * vec3(0.7, 1, 1)));
		vec3 p = getGlobalPosition(localPos);
		vec3 n = getNoiseFromPositionAndTime(vec4((p / 10), t), (drag.yxz * vec3(0.7, 1, 1)));
		n = mix(localNoise, n, gravityScale);
		ghostNoiseMagnitude = (abs(((n.x + n.y) + n.z)) * max(0.3, ghostLayerFullness));
	}
	gl_Position = ((ProjMat * ModelViewMat) * vec4(pos, 1));
	gl_Position.z -= 1.0E-5;
	depth = gl_Position.z;
}
