vec3 GetRawWave(in vec3 pos, float wind) {
float magnitude = sin(wind * 0.0027f + pos.x + pos.y) * 0.04f + 0.04f;
float d0 = sin(wind * 0.0127f);
float d1 = sin(wind * 0.0089f);
float d2 = sin(wind * 0.0114f);
vec3 wave;
wave.x = magnitude * sin(wind * 0.0224f + d1 + d2 + pos.x - pos.z + pos.y);
wave.y = magnitude * sin(wind * 0.0015f + d2 + d0 + pos.x);
wave.z = magnitude * sin(wind * 0.0063f + d0 + d1 - pos.x + pos.z + pos.y);
return wave;
}
vec3 GetWave(in vec3 pos, float waveSpeed) {
float wind = frameTimeCounter * waveSpeed * 1.0f;
vec3 wave = GetRawWave(pos, wind);
float wavingIntensity = 1.0f * mix(1.0f, 100 * 0.01f, rainFactor);
return wave * wavingIntensity;
}
void DoWave_Foliage(inout vec3 playerPos, vec3 worldPos, float waveMult) {
worldPos.y *= 0.5f;
vec3 wave = GetWave(worldPos, 170.0f);
wave.x = wave.x * 3.0f;
wave.y = 0.0f;
wave.z = wave.z * 8.0f + wave.y * 4.0f;
wave *= clamp(lmCoord.y - 0.87f, 0.0f, 0.1f);
playerPos.xyz += wave * waveMult;
}
void DoWave_Leaves(inout vec3 playerPos, vec3 worldPos, float waveMult) {
worldPos *= vec3(0.75f, 0.375f, 0.75f);
vec3 wave = GetWave(worldPos, 170.0f);
wave *= vec3(4.0f, 3.0f, 8.0f);
wave *= 1.0f - inSnowy;
wave *= clamp(lmCoord.y - 0.87f, 0.0f, 0.1f);
playerPos.xyz += wave * waveMult;
}
void DoWave_Water(inout vec3 playerPos, vec3 worldPos) {
float waterWaveTime = frameTimeCounter * 6.0f * 1.0f;
worldPos.xz *= 14.0f;
float wave = sin(waterWaveTime * 0.7f - worldPos.z * 0.14f + worldPos.x * 0.07f);
wave += sin(waterWaveTime * 0.5f - worldPos.z * 0.1f + worldPos.x * 0.05f);
wave *= clamp(lmCoord.y - 0.87f, 0.0f, 0.1f);
wave = wave * 0.125f - 0.05f;
playerPos.y += wave;
}
void DoWave_Lava(inout vec3 playerPos, vec3 worldPos) {
if (fract(worldPos.y + 0.005f) > 0.06f) {
float lavaWaveTime = frameTimeCounter * 3.0f * 1.0f;
worldPos.xz *= 14.0f;
float wave = sin(lavaWaveTime * 0.7f - worldPos.z * 0.14f + worldPos.x * 0.07f);
wave += sin(lavaWaveTime * 0.5f - worldPos.z * 0.05f + worldPos.x * 0.1f);
playerPos.y += wave * 0.0125f;
}
}
